{
  "manifest_version": 3,
  "name": "Screen Q&A",
  "version": "0.4.0",
  "description": "Continuous ambient in-page Q&A HUD, SidePanel companion, and Mobile Lens powered by Fleet-Orchestrator & Gemini Flash.",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "http://192.168.*:*/*",
    "https://192.168.*:*/*",
    "http://10.*:*/*",
    "https://10.*:*/*",
    "http://172.16.*:*/*",
    "https://172.16.*:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-scan": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Toggle ambient Q&A scanning on/off"
    }
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Screen Q&A (Click to open SidePanel)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
